# Import required libraries
import numpy as np
import random
# Algorithm Step 1: Define the maze with a start point (S), empty paths (.), walls (#) and goal (G)
maze = [
    ['S', '.', '.', '#'],
    ['#', '.', '.', '#'],
    ['#', '.', '.', '.'],
    ['#', '#', '.', 'G']
]
# Get the number of rows and columns in the maze
rows = len(maze)
cols = len(maze[0])
start = (0, 0)
goal = (3, 3)
# Algorithm Step 2: Define actions as up, down, left and right
actions = [0, 1, 2, 3]
# Algorithm Step 3: Initialize the Q-table with zeros for every state and action
Q = np.zeros((rows, cols, 4))
# Set the learning rate, discount factor, exploration rate and number of episodes
alpha = 0.8
gamma = 0.9
epsilon = 0.2
episodes = 1000
# Algorithm Step 4: Define the movement rules and rewards for the maze
def move(state, action):
    r, c = state
    if action == 0:
        r -= 1
    elif action == 1:
        r += 1
    elif action == 2:
        c -= 1
    elif action == 3:
        c += 1
    if r < 0 or r >= rows or c < 0 or c >= cols:
        return state, -10
    if maze[r][c] == '#':
        return state, -10
    if maze[r][c] == 'G':
        return (r, c), 100
    return (r, c), -1
# Algorithm Step 5: Train the agent for multiple episodes using the epsilon-greedy policy
for episode in range(episodes):
    state = start
    for step in range(100):
        if random.random() < epsilon:
            action = random.choice(actions)
        else:
            action = np.argmax(Q[state[0], state[1]])
        next_state, reward = move(state, action)
        Q[state[0], state[1], action] = Q[state[0], state[1], action] + alpha * (reward + gamma * np.max(Q[next_state[0], next_state[1]]) - Q[state[0], state[1], action])
        state = next_state
        if state == goal:
            break
# Display Q-table with maze coordinates
print("\nQ-Table with Coordinates:")

for r in range(rows):
    for c in range(cols):
        print(
            f"Position ({r},{c}): "
            f"Up={Q[r,c,0]:.2f}, "
            f"Down={Q[r,c,1]:.2f}, "
            f"Left={Q[r,c,2]:.2f}, "
            f"Right={Q[r,c,3]:.2f}"
        )
# Algorithm Step 6: Follow the learned policy to find a path from start to goal
state = start
path = [state]
visited = {state}
for step in range(20):
    action = np.argmax(Q[state[0], state[1]])
    next_state, reward = move(state, action)
    if next_state == state or next_state in visited:
        break
    state = next_state
    path.append(state)
    visited.add(state)
    if state == goal:
        break
# Display the learned Q-table and the path found by the agent
print("Q-Table:")
print(Q)
print("\nLearned Path:")
print(path)
