import numpy as np
import random
maze = [
    ['S', '.', '.', '#'],
    ['#', '.', '.', '#'],
    ['#', '.', '.', '.'],
    ['#', '#', '.', 'G']
]
rows = len(maze)
cols = len(maze[0])
start = (0, 0)
goal = (3, 3)
actions = [0, 1, 2, 3]
Q = np.zeros((rows, cols, 4))
alpha = 0.8      
gamma = 0.9       
epsilon = 0.2    
episodes = 1000
def move(state, action):
    r, c = state
    if action == 0:      
        r -= 1
    elif action == 1:     
        r += 1
    elif action == 2:     
        c -= 1
    elif action == 3:     
        c += 1
    if r < 0 or r >= rows or c < 0 or c >= cols:
        return state, -10
    if maze[r][c] == '#':
        return state, -10
    if maze[r][c] == 'G':
        return (r, c), 100
    return (r, c), -1
for episode in range(episodes):
    state = start
    for step in range(100):
        if random.random() < epsilon:
            action = random.choice(actions)
        else:
            action = np.argmax(Q[state[0], state[1]])
        next_state, reward = move(state, action)
        Q[state[0], state[1], action] = Q[state[0], state[1], action] + alpha * (
            reward +
            gamma * np.max(Q[next_state[0], next_state[1]]) -
            Q[state[0], state[1], action]
        )
        state = next_state
        if state == goal:
            break
print("Q-Table:")
print(Q)
state = start
path = [state]
for step in range(20):
    action = np.argmax(Q[state[0], state[1]])
    next_state, reward = move(state, action)
    if next_state == state:
        break
    state = next_state
    path.append(state)
    if state == goal:
        break
print("\nLearned Path:")
print(path)
