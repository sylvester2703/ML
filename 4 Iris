%pip install kneed
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans 
from kneed import KneeLocator
# Step 1: Load the Iris dataset
df = pd.read_csv(r"C:\Users\Dell\OneDrive\Desktop\ML Datasets\Iris.csv")
# Step 2: Select the four numerical features for clustering
X = df[["SepalLengthCm", "SepalWidthCm", "PetalLengthCm", "PetalWidthCm"]]
# Step 3: Calculate WCSS for K values from 1 to 10
wcss = []
K = range(1, 11)
for k in K:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(X)
    wcss.append(kmeans.inertia_)  # Store WCSS for each K
# Step 4: Automatically detect the elbow point
knee = KneeLocator(list(K), wcss, curve="convex", direction="decreasing")
optimal_k = knee.elbow
# Step 5: Plot the elbow graph
plt.plot(list(K), wcss, marker="o")

if optimal_k is not None:
    plt.axvline(optimal_k, color="red", linestyle="--",
                label=f"Optimal K = {optimal_k}")
    plt.legend()
plt.xlabel("Number of Clusters (K)")
plt.ylabel("WCSS")
plt.title("Elbow Method with Automatic Elbow Detection")
plt.xticks(list(K))
plt.grid(True)
plt.show()
# Step 6: Apply K-Means using the detected optimal K
if optimal_k is not None:
    kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
    df["Cluster"] = kmeans.fit_predict(X)  # Assign a cluster to each flower
    print("Automatically detected optimal number of clusters:", optimal_k)
    print(df.head())
    # Step 7: Save the dataset with cluster assignments
    df.to_csv("Iris_Clustered.csv", index=False)
    print("Clustered dataset saved as Iris_Clustered.csv")

else:
    print("Elbow point could not be detected automatically.")
    print("Try adjusting the K range or reviewing the elbow graph.")
